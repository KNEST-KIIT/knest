{
  "name": "knest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs'); if (fs.existsSync('.next/standalone')) { fs.cpSync('.next/static', '.next/standalone/.next/static', {recursive: true, force: true}); if (fs.existsSync('public')) fs.cpSync('public', '.next/standalone/public', {recursive: true, force: true}); }\"",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "migrate": "tsx src/db/migrate.ts && payload migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:demo": "tsx src/db/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "test:db": "tsx tests/support/dev-pg.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "framer-motion": "^13.1.1",
    "graphql": "^16.14.2",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.0.16",
    "payload": "3.90.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
