# ---- Database ----
# Local dev via docker-compose, or an RDS endpoint in AWS.
DATABASE_URL=postgres://knest:knest@127.0.0.1:5432/knest

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional in dev; leave blank to disable the provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Payload ----
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-32-byte-random-string

# ---- Email (AWS SES in production; leave blank to log to console in dev) ----
EMAIL_FROM="KNEST <no-reply@knest.kiit.ac.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- CMS media (S3 + CloudFront in production; local disk in dev) ----
# S3_BUCKET holds CMS images only. Applicant documents use the buckets below.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=

# ---- Applicant documents: malware screening (required in production; the server refuses to start without these) ----
# An upload lands in QUARANTINE_BUCKET, is scanned by GuardDuty Malware Protection for S3, and is copied to
# DOCUMENTS_BUCKET only after a clean result for that exact object version. Results arrive on an SQS queue.
# S3_BUCKET, QUARANTINE_BUCKET and DOCUMENTS_BUCKET must be three different buckets. Without these settings, uploads answer 503.
# For local work run `pnpm dev:local`: it starts local stand-ins for S3 and SQS (they are NOT a virus scanner).
QUARANTINE_BUCKET=
DOCUMENTS_BUCKET=
DOCUMENTS_KMS_KEY_ARN=
MALWARE_SCAN_QUEUE_URL=
# Optional: minutes to wait for a verdict before a file is failed closed (default 30).
# MALWARE_SCAN_DEADLINE_MINUTES=30

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Feature flags ----
# Lab booking is a contracted module being rebuilt (ADR-002). Keep off until then.
FEATURE_LAB_BOOKING=false
# QR attendance (signed passes, scan, PWA, offline). Needs FEATURE_LAB_BOOKING too. Keep off until KIIT and a
# lab head have signed off docs/delivery/LAB-ATTENDANCE-THREAT-MODEL.md and the real-device protocol has been run.
FEATURE_LAB_ATTENDANCE_QR=false
