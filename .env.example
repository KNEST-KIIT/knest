# ---- Database ----
# Local dev via docker-compose, or an RDS endpoint in AWS.
DATABASE_URL=postgres://knest:knest@127.0.0.1:5432/knest

# ---- Auth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (optional in dev; leave blank to disable the provider)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Payload ----
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-me-with-a-32-byte-random-string

# ---- Email (AWS SES in production; leave blank to log to console in dev) ----
EMAIL_FROM="KNEST <no-reply@knest.kiit.ac.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Media (S3 + CloudFront in production; local disk in dev) ----
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
