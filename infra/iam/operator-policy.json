{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadAndChangeKnestStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:CreateStack",
        "cloudformation:UpdateStack",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplate",
        "cloudformation:ListChangeSets"
      ],
      "Resource": "arn:aws:cloudformation:*:166917387892:stack/knest-production-*/*"
    },
    {
      "Sid": "ValidateAndList",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StacksActThroughTheServiceRoleOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::166917387892:role/knest-production-cfn-deploy",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DeployByDigestAndRunSmoke",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:*:166917387892:document/knest-production-deploy",
        "arn:aws:ssm:*::document/AWS-RunShellScript",
        "arn:aws:ec2:*:166917387892:instance/*"
      ],
      "Condition": {
        "StringEqualsIfExists": {
          "ssm:resourceTag/knest-deploy-target": "production"
        }
      }
    },
    {
      "Sid": "ReadOperationalState",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations",
        "ssm:DescribeInstanceInformation",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ec2:Describe*",
        "elasticloadbalancing:Describe*",
        "cloudfront:Get*",
        "cloudfront:List*",
        "cloudfront:CreateInvalidation",
        "wafv2:Get*",
        "wafv2:List*",
        "acm:ListCertificates",
        "acm:DescribeCertificate",
        "acm:RequestCertificate",
        "ses:Get*",
        "ses:List*",
        "sesv2:Get*",
        "sesv2:List*",
        "sns:ListTopics",
        "sns:ListSubscriptionsByTopic",
        "sns:GetTopicAttributes",
        "cloudwatch:Describe*",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "logs:Describe*",
        "logs:Get*",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "ecr:Describe*",
        "ecr:List*",
        "ecr:GetAuthorizationToken",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:DescribeImageScanFindings",
        "ce:Get*",
        "budgets:ViewBudget",
        "budgets:Describe*",
        "route53:Get*",
        "route53:List*",
        "s3:ListBucket",
        "s3:GetBucketVersioning",
        "rds:Describe*",
        "rds:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnapshotsAndRestoreDrills",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBSnapshot",
        "rds:RestoreDBInstanceFromDBSnapshot",
        "rds:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:rds:*:166917387892:snapshot:pre-migrate-*",
        "arn:aws:rds:*:166917387892:snapshot:knest-drill-*",
        "arn:aws:rds:*:166917387892:db:knest-production-*",
        "arn:aws:rds:*:166917387892:db:knest-drill-*",
        "arn:aws:rds:*:166917387892:subgrp:*",
        "arn:aws:rds:*:166917387892:pg:*"
      ]
    },
    {
      "Sid": "DnsChangesOnTheKnestZonesOnly",
      "Effect": "Allow",
      "Action": [
        "route53:ChangeResourceRecordSets"
      ],
      "Resource": "arn:aws:route53:::hostedzone/*"
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:CreateBudgetAction"
      ],
      "Resource": "arn:aws:budgets::166917387892:budget/knest-*"
    },
    {
      "Sid": "NeverReadSecretValuesNeverTouchIdentityOrDelete",
      "Effect": "Deny",
      "Action": [
        "iam:Create*",
        "iam:Delete*",
        "iam:Put*",
        "iam:Attach*",
        "iam:Detach*",
        "iam:Update*",
        "iam:Add*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Tag*",
        "iam:Untag*",
        "secretsmanager:GetSecretValue",
        "organizations:*",
        "account:*",
        "kms:ScheduleKeyDeletion",
        "kms:Decrypt",
        "cloudformation:DeleteStack",
        "rds:DeleteDBInstance",
        "rds:DeleteDBSnapshot",
        "rds:ModifyDBInstance",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "ec2:TerminateInstances",
        "route53:DeleteHostedZone",
        "cloudfront:DeleteDistribution",
        "acm:DeleteCertificate",
        "ses:DeleteIdentity",
        "sesv2:DeleteEmailIdentity"
      ],
      "Resource": "*"
    }
  ]
}
