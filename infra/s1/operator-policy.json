{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StayInMumbaiAndVirginia",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "sts:*",
        "budgets:*",
        "ce:*",
        "account:*",
        "billing:*",
        "freetier:*",
        "support:*",
        "health:*",
        "signin:*",
        "cloudfront:*",
        "wafv2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-south-1",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "NeverCreateLongLivedCredentialsOrUsers",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:DeleteUser",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:DeleteAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "iam:DetachUserPolicy",
        "iam:DeleteUserPolicy",
        "iam:AddUserToGroup"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOnlyInspection",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*",
        "iam:GenerateCredentialReport",
        "iam:GetCredentialReport",
        "account:Get*",
        "account:List*",
        "freetier:Get*",
        "billing:Get*",
        "ce:Get*",
        "ce:Describe*",
        "ce:List*",
        "ec2:Describe*",
        "rds:Describe*",
        "s3:ListAllMyBuckets",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "logs:Describe*",
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:Get*",
        "cloudformation:ValidateTemplate",
        "ssm:Describe*",
        "ssm:ListCommandInvocations",
        "cloudtrail:LookupEvents",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S1StackAndNetwork",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-south-1:*:stack/knest-s1*/*",
        "arn:aws:cloudformation:us-east-1:*:stack/knest-s1*/*"
      ]
    },
    {
      "Sid": "S1ComputeAndDatabase",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "rds:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "S1Bucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::knest-s1-*",
        "arn:aws:s3:::knest-s1-*/*"
      ]
    },
    {
      "Sid": "S1LogsAndSecrets",
      "Effect": "Allow",
      "Action": [
        "logs:*",
        "ssm:*"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:*:log-group:/knest-s1*",
        "arn:aws:logs:ap-south-1:*:log-group:/knest-s1*:*",
        "arn:aws:ssm:ap-south-1:*:parameter/knest-s1/*",
        "arn:aws:ssm:ap-south-1:*:document/*",
        "arn:aws:ssm:ap-south-1:*:managed-instance/*",
        "arn:aws:ec2:ap-south-1:*:instance/*",
        "arn:aws:ssm:ap-south-1:*:session/*"
      ]
    },
    {
      "Sid": "S1RolesOnlyForKnestS1",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:AddRoleToInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:role/knest-s1-*",
        "arn:aws:iam::*:instance-profile/knest-s1-*"
      ]
    },
    {
      "Sid": "PassOnlyS1Roles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/knest-s1-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ec2.amazonaws.com",
            "scheduler.amazonaws.com",
            "cloudformation.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "RdsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/rds.amazonaws.com/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "rds.amazonaws.com"
        }
      }
    },
    {
      "Sid": "S1BudgetsAndTeardownSchedule",
      "Effect": "Allow",
      "Action": [
        "budgets:ViewBudget",
        "budgets:ModifyBudget",
        "scheduler:*"
      ],
      "Resource": [
        "arn:aws:budgets::*:budget/knest-s1*",
        "arn:aws:scheduler:ap-south-1:*:schedule/*/knest-s1*",
        "arn:aws:scheduler:ap-south-1:*:schedule-group/knest-s1*"
      ]
    },
    {
      "Sid": "SchedulerList",
      "Effect": "Allow",
      "Action": [
        "scheduler:List*",
        "scheduler:Get*",
        "budgets:ViewBudget"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoComputeOrDatabaseOutsideMumbai",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:CreateVpc",
        "ec2:CreateVolume",
        "rds:CreateDBInstance",
        "rds:CreateDBCluster"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "ap-south-1"
        }
      }
    },
    {
      "Sid": "CloudFrontTestDistributionAndFunctions",
      "Effect": "Allow",
      "Action": [
        "cloudfront:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WafForTheTestDistribution",
      "Effect": "Allow",
      "Action": [
        "wafv2:*"
      ],
      "Resource": [
        "arn:aws:wafv2:us-east-1:*:global/*/knest-s1-*/*",
        "arn:aws:wafv2:us-east-1:*:global/managedruleset/*/*",
        "arn:aws:wafv2:us-east-1:*:global/ipset/knest-s1-*/*",
        "arn:aws:wafv2:us-east-1:*:global/regexpatternset/knest-s1-*/*"
      ]
    },
    {
      "Sid": "WafListAndCheck",
      "Effect": "Allow",
      "Action": [
        "wafv2:List*",
        "wafv2:Get*",
        "wafv2:CheckCapacity",
        "wafv2:DescribeManagedRuleGroup"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrRepositoryForS1",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "arn:aws:ecr:ap-south-1:*:repository/knest-s1*"
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "GitHubOidcProviderOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider",
        "iam:GetOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": "arn:aws:iam::*:oidc-provider/token.actions.githubusercontent.com"
    },
    {
      "Sid": "RdsManagedMasterSecretMetadataOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:ListSecrets",
        "secretsmanager:TagResource",
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:PutResourcePolicy",
        "secretsmanager:GetResourcePolicy"
      ],
      "Resource": "arn:aws:secretsmanager:ap-south-1:*:secret:rds!*"
    },
    {
      "Sid": "TheOperatorNeverReadsSecretValues",
      "Effect": "Deny",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "*"
    },
    {
      "Sid": "TheOperatorNeverReadsS1Parameters",
      "Effect": "Deny",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:ap-south-1:*:parameter/knest-s1/*"
    }
  ]
}
